#!/usr/bin/env fish
# Rejects a commit whose subject line is not a Conventional Commit in this
# repo's dialect (see the Git section of CLAUDE.md):
#
#   <type>(<scope>)[!]: <summary>
#
# type: feat | fix | perf | refactor | style | docs | chore; scope: one word, and
# the only part that may be left out (docs: add CLAUDE.md);
# summary: lowercase start, no trailing period, at most 72 characters.
#
# Enable once per clone:  git config core.hooksPath .githooks

set -l subject (string match -rv '^#' <$argv[1] | string match -rv '^\s*$')[1]

# Commits git writes itself.
string match -rq '^(Merge |Revert |fixup! |squash! )' -- $subject; and exit 0

function fail -V subject
    echo "commit-msg: $argv[1]" >&2
    echo "  subject: $subject" >&2
    echo "  expected: <type>(<scope>): <summary>, e.g. chore(content): add two moments" >&2
    exit 1
end

set -l summary (string replace -rf '^(feat|fix|perf|refactor|style|docs|chore)(\([^()\s]+\))?!?: (.+)$' '$3' -- $subject)

test -n "$summary"
or fail "subject is not <type>(<scope>): <summary> (type: feat, fix, perf, refactor, style, docs, chore)"

string match -rq '^\p{Lu}' -- $summary; and fail "summary starts with an uppercase letter"
string match -q '*.' -- $summary; and fail "summary ends with a period"

# string length counts characters, not bytes: the summary may contain Chinese.
set -l length (string length -- $summary)
test $length -le 72; or fail "summary is $length characters; the limit is 72"

exit 0
