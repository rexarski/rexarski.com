#!/usr/bin/env fish
# Warns, never blocks:
# - when the local Hugo differs from the HUGO_VERSION that netlify.toml pins
#   for deploys: a template that builds here may not build there. Fix by
#   setting the pin to the local version.
# - when posts are staged without data/related_posts.json: the related-posts
#   index is probably stale. Fix by running ./refresh.fish and staging it.
#
# Enable once per clone:  git config core.hooksPath .githooks

set -l root (git rev-parse --show-toplevel)

if command -q hugo
    set -l pinned (string replace -rf '^\s*HUGO_VERSION\s*=\s*"([^"]+)".*' '$1' <$root/netlify.toml)[1]
    set -l local (hugo version | string replace -rf '^hugo v(\d+\.\d+\.\d+).*' '$1')[1]
    if test -n "$pinned" -a -n "$local" -a "$pinned" != "$local"
        echo "pre-commit: local Hugo is $local, netlify.toml pins $pinned" >&2
        echo "  suggest: set HUGO_VERSION = \"$local\" in netlify.toml" >&2
    end
end

set -l staged (git diff --cached --name-only --diff-filter=ACMRD)
if string match -q 'content/posts/*.md' -- $staged
    and not contains data/related_posts.json $staged
    echo "pre-commit: posts changed but data/related_posts.json is not staged" >&2
    echo "  suggest: ./refresh.fish, then git add data/related_posts.json" >&2
end

exit 0
